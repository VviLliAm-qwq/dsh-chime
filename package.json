{
  "name": "dsh-chime",
  "version": "0.2.0",
  "description": "Notification sounds for dsh-tui: distinct tones for conversation done / user question, focused vs unfocused terminal, 4 selectable sound groups, master volume 0-150% in 5% steps, settings section, zh/en",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VviLliAm-qwq/dsh-chime.git"
  },
  "author": "VviLliAm-qwq",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-tui",
    "deepseek-harness",
    "notification",
    "sound",
    "chime",
    "win32"
  ],
  "files": [
    "lib",
    "assets",
    "dsh-plugin.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "koffi": "^3.1.0"
  }
}
